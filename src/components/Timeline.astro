---
/* The career timeline, told backwards: the stage (TimelineStage.astro) stays in view on the left while the chapters
   (Chapter.astro, content in timeline-chapters.js) scroll past on the right. On narrow screens the stage becomes a
   bar across the top. */
import TimelineStage from './TimelineStage.astro';
import Chapter from './Chapter.astro';
import { chapters } from './timeline-chapters.js';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
---
<section class="timeline">
    <div class="wrap">
      <TimelineStage lang={lang} />

      <div class="chapters">
        {chapters.map(chapter => <Chapter lang={lang} {...chapter} />)}
      </div>
    </div>
  </section>

<style is:global>
  .timeline .wrap { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: clamp(24px,5vw,80px); }
  .chapters { display: grid; padding-block: 10vh 20vh; }
  @media (max-width: 980px) {
    .timeline .wrap { grid-template-columns: 1fr; gap: 0; }
  }
</style>
