---
/* Teams: "One product, five cities". The text, a MADS compact card per city (CompactCard.astro) and the dot map of
   Europe. The map's drawing is in src/template/teams-map.html; the page script draws the flight arcs and the cities on
   it (#arcs, #cities). The text comes from translations/ (keys below and in the map). */
import CompactCard from '@maadan/mads/components/CompactCard.astro';
import { texts, fill } from '../i18n.js';
import map from '../template/teams-map.html?raw';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const { T } = texts(lang);

const cities = [
  { city: 'map.city_stockholm', text: 'teams.sweden_cet' },
  { city: 'map.city_london', text: 'teams.united_kingdom_gmt' },
  { city: 'map.city_paris', text: 'teams.france_cet' },
  { city: 'map.city_gibraltar', text: 'teams.gibraltar_cet' },
  { city: 'map.city_madrid', text: 'teams.spain_cet_home_base', home: true },
];
---
<section class="sec map" id="teams">
    <div class="wrap">
      <div>
        <div class="sec-head" style="margin-bottom:0">
          <p class="eyebrow" set:html={T('teams.international_teams')} />
          <h2><Fragment set:html={T('teams.one_product')} />{' '}<span class="mads-text-gradient" set:html={T('teams.five_cities')} /></h2>
          <p set:html={T('teams.since_joining_current_company')} />
          <p set:html={T('teams.keep_them_pulling_one')} />
        </div>
        <div class="cities">
          {cities.map(c => <CompactCard title={T(c.city)} class={c.home ? 'home' : undefined}><Fragment set:html={T(c.text)} /></CompactCard>)}
        </div>
      </div>
      <div class="map-art">
        <Fragment set:html={fill(map, lang)} />
      </div>
    </div>
  </section>

<style is:global>
  .map .wrap { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .map-art { position: relative; min-width: 0; }
  .map-art svg { width: 100%; height: auto; overflow: visible; display: block; }
  .dots-d { opacity: var(--dots-d); }
  .dots-l { opacity: var(--dots-l); }
  .arc { fill: none; stroke-width: 1.6; stroke-dasharray: 4 6; animation: dash 1.8s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -20; } }
  .city circle.core { stroke: var(--mads-theme-background); stroke-width: 2; }
  .city .ping { fill: none; stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: ping 2.4s ease-out infinite; }
  /* the ping animation is in site.css: the logo's click ripple uses it too */
  .city text { font: var(--mads-label-weight) var(--mads-label-xsmall-size) var(--mads-font-mono); fill: var(--mads-theme-text); letter-spacing: .04em; }
  .city text.sub { font-weight: 400; fill: var(--mads-theme-text-muted); font-size: 9px; }
  .cities { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 28px; }
  .cities .home { grid-column: 1 / -1; }
  @media (max-width: 980px) {
    .map .wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .cities { grid-template-columns: 1fr 1fr; }
  }
</style>
