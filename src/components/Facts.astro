---
/* Facts: the four numbers under the hero, each a MADS stat (Stat.astro). The labels come from translations/ (keys below);
   the accent is a mads.theme text role ('text-…') or a mads.color. */
import Stat from '@maadan/mads/components/Stat.astro';
import { texts } from '../i18n.js';

interface Props {
  lang: 'en' | 'es';
}

const { T } = texts(Astro.props.lang);

const facts = [
  { value: '20+', text: 'facts.years_building_native_apps', accent: 'text-amber-gold' },
  { value: '5', text: 'facts.cities_one_distributed_team', accent: 'blaze-orange' },
  { value: '6', text: 'facts.roles_ios_developer_product', accent: 'text-neon-pink' },
  { value: T('facts.99_9'), text: 'facts.crashfree_users_every_app', accent: 'text-azure-blue' },
];
---
<div class="facts">
    <div class="wrap">
      {facts.map(fact => <Stat value={fact.value} accent={fact.accent} class="fact"><Fragment set:html={T(fact.text)} /></Stat>)}
    </div>
  </div>

<style is:global>
  .facts { border-block: 1px solid var(--mads-theme-line); background: color-mix(in srgb, var(--mads-theme-surface) 70%, transparent); }
  .facts .wrap { max-width: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .fact { padding: 28px 22px; border-left: 1px solid var(--mads-theme-line); }
  .fact:first-child { border-left: 0; }
  @media (max-width: 980px) {
    .facts .wrap { grid-template-columns: 1fr 1fr; }
    .fact:nth-child(3) { border-left: 0; }
    .fact:nth-child(n+3) { border-top: 1px solid var(--mads-theme-line); }
  }
  @media (max-width: 620px) {
    .fact { padding: 22px 14px; }
  }
</style>
